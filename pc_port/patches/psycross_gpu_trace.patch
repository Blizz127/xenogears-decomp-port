+/* _xeno_gpu_trace */
+extern "C" int PsyX_GpuTraceOn(void);
+extern int g_xeno_swap_index;
+extern unsigned short vram[];
+
+/* _xeno_gpu_trace: with XENO_GPU_TRACE_VRAM=dir also write the CPU VRAM
+ * mirror (1024x512 u16) at each traced present, before the present runs. */
+static void PsyX_GpuTraceDumpVRAM(const char* path)
+{
+	const char* dir = getenv("XENO_GPU_TRACE_VRAM");
+	char name[512];
+	FILE* f;
+	if (!dir || !*dir || !PsyX_GpuTraceOn())
+		return;
+	snprintf(name, sizeof(name), "%s/vram_%06d_%s.bin", dir, g_xeno_swap_index, path);
+	f = fopen(name, "wb");
+	if (!f)
+		return;
+	fwrite(vram, sizeof(unsigned short), VRAM_WIDTH * VRAM_HEIGHT, f);
+	fclose(f);
+}
