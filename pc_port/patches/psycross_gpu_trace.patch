+/* _xeno_gpu_trace: XENO_GPU_TRACE=a-b logs every display/VRAM call made while
+ * the presented-frame index is in [a,b] ("1" = all).  Diagnostic only; off by
+ * default and silent when unset. */
+extern int g_xeno_swap_index;
+extern "C" int PsyX_GpuTraceOn(void)
+{
+	static int init = 0, lo = 0, hi = -1;
+	if (!init)
+	{
+		const char* e = getenv("XENO_GPU_TRACE");
+		init = 1;
+		if (e && *e)
+		{
+			if (sscanf(e, "%d-%d", &lo, &hi) != 2) { lo = 0; hi = 0x7FFFFFFF; }
+		}
+	}
+	return g_xeno_swap_index >= lo && g_xeno_swap_index <= hi;
+}
+#define XENO_GPU_TRACE(...) do { if (PsyX_GpuTraceOn()) { printf("[gputrace] s=%d ", g_xeno_swap_index); printf(__VA_ARGS__); printf("\n"); fflush(stdout); } } while (0)
