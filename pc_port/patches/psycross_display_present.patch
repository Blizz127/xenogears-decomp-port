+/* _xeno_display_present: convert the DISPENV rect of the CPU VRAM mirror to
+ * RGBA8 (15-bit texels, or 24-bit packed bytes when rgb24) and blit it over
+ * the whole window, flipped like GR_MaterializeFramebufferRect.  Used when a
+ * vblank passes without any primitive having been drawn. */
+void GR_PresentVRAMDisplay(int x, int y, int w, int h, int rgb24, int displayEnabled)
+{
+#if USE_OPENGL
+	static GLuint tex = 0;
+	static GLuint fbo = 0;
+	static int texW = 0;
+	static int texH = 0;
+	static u_int* pixels = NULL;
+	static size_t pixelsCap = 0;
+
+	if (w <= 0 || h <= 0)
+		return;
+
+	if ((size_t)w * h > pixelsCap)
+	{
+		free(pixels);
+		pixelsCap = (size_t)w * h;
+		pixels = (u_int*)malloc(pixelsCap * sizeof(u_int));
+		if (!pixels)
+		{
+			pixelsCap = 0;
+			return;
+		}
+	}
+
+	/* SetDispMask(0) gates scanout, not VRAM writes.  Preserve every VRAM byte
+	 * while presenting hardware-black until the game enables the display. */
+	if (!displayEnabled)
+		memset(pixels, 0, (size_t)w * h * sizeof(*pixels));
+	else for (int j = 0; j < h; j++)
+	{
+		const unsigned short* row = &vram[((y + j) & (VRAM_HEIGHT - 1)) * VRAM_WIDTH];
+		u_int* out = &pixels[j * w];
+
+		if (rgb24)
+		{
+			const unsigned char* bytes = (const unsigned char*)row;
+			for (int i = 0; i < w; i++)
+			{
+				int o = x * 2 + i * 3;
+				if (o + 2 >= VRAM_WIDTH * 2)
+				{
+					out[i] = 0xFF000000u;
+					continue;
+				}
+				out[i] = (u_int)bytes[o] | ((u_int)bytes[o + 1] << 8) |
+					((u_int)bytes[o + 2] << 16) | 0xFF000000u;
+			}
+		}
+		else
+		{
+			for (int i = 0; i < w; i++)
+			{
+				unsigned short p = row[(x + i) & (VRAM_WIDTH - 1)];
+				u_int r = (p & 31) << 3;
+				u_int g = ((p >> 5) & 31) << 3;
+				u_int b = ((p >> 10) & 31) << 3;
+				out[i] = r | (g << 8) | (b << 16) | 0xFF000000u;
+			}
+		}
+	}
+
+	if (!tex)
+		glGenTextures(1, &tex);
+	if (!fbo)
+		glGenFramebuffers(1, &fbo);
+
+	glBindTexture(GL_TEXTURE_2D, tex);
+	if (texW != w || texH != h)
+	{
+		glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+		texW = w;
+		texH = h;
+	}
+	else
+	{
+		glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+	}
+	glBindTexture(GL_TEXTURE_2D, 0);
+
+	glBindFramebuffer(GL_READ_FRAMEBUFFER, fbo);
+	glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, tex, 0);
+	glBindFramebuffer(GL_DRAW_FRAMEBUFFER, 0);
+	glBlitFramebuffer(0, 0, w, h,
+	                  0, g_windowHeight, g_windowWidth, 0,
+	                  GL_COLOR_BUFFER_BIT, GL_NEAREST);
+	glBindFramebuffer(GL_FRAMEBUFFER, 0);
+#endif
+}
