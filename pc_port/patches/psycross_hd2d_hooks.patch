+
+static inline bool Hd2dPrim(int tpage, int clut, unsigned char* const* uv, int n, bool semiTrans)
+{
+	if (!PcPort_Hd2dTextureOverride || overrideTexture != 0)
+		return false;
+	int u0 = 255, v0 = 255, u1 = 0, v1 = 0;
+	for (int i = 0; i < n; i++) {
+		if (uv[i][0] < u0) u0 = uv[i][0];
+		if (uv[i][0] > u1) u1 = uv[i][0];
+		if (uv[i][1] < v0) v0 = uv[i][1];
+		if (uv[i][1] > v1) v1 = uv[i][1];
+	}
