+/* _xeno_hd2d_hooks: UV rect of a HOOK 3 override split (RGBA shader). The
+ * uniform is uploaded only when it changes, and only on RGBA splits, which
+ * retail content never produces. */
+void GR_SetHd2dUvRect(int on, const float* uv)
+{
+#if USE_OPENGL
+	static GLuint program = 0;
+	static GLint onLoc = -1, rectLoc = -1;
+	static int lastOn = 0;
+	static float last[4];
+	if (program != g_gpu_shader_32_rgba.shader) {
+		program = g_gpu_shader_32_rgba.shader;
+		onLoc = glGetUniformLocation(program, "u_hd2dUvOn");
+		rectLoc = glGetUniformLocation(program, "u_hd2dUvRect");
+		lastOn = -1;
+	}
+	if (!on && lastOn == 0)
+		return;
+	if (on && lastOn == 1 && memcmp(last, uv, sizeof(last)) == 0)
+		return;
+	if (onLoc != -1)
+		glUniform1i(onLoc, on ? 1 : 0);
+	if (on && rectLoc != -1)
+		glUniform4f(rectLoc, uv[0], uv[1], uv[2], uv[3]);
+	lastOn = on ? 1 : 0;
+	if (on)
+		memcpy(last, uv, sizeof(last));
+#endif
+}
