+/* Ask the hook; on 1 open the override split for this primitive. */
+static bool Hd2dBeginPrim(int tpage, int clut, int u0, int v0, int u1, int v1, bool semiTrans)
+{
+	unsigned int texture = 0;
+	float uv[4] = { 0.0f, 0.0f, 1.0f, 1.0f };
+	if (!PcPort_Hd2dTextureOverride(tpage, clut, u0, v0, u1, v1, &texture, uv) || texture == 0)
