+
+static inline bool Hd2dRect(int tpage, int clut, const unsigned char* uv, int w, int h, bool semiTrans)
+{
+	if (!PcPort_Hd2dTextureOverride || overrideTexture != 0)
+		return false;
+	return Hd2dBeginPrim(tpage, clut, uv[0], uv[1], uv[0] + (w > 0 ? w - 1 : 0), uv[1] + (h > 0 ? h - 1 : 0), semiTrans);
