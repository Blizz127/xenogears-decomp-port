+/* Re-express the emitted retail texcoords as 0..255 across the primitive's
+ * UV bounds; the RGBA shader maps them onto the split's UV rect. */
+static void Hd2dRetarget(GrVertex* vertex, int n)
+{
+	int u0 = 255, v0 = 255, u1 = 0, v1 = 0;
+	for (int i = 0; i < n; i++) {
+		if (vertex[i].u < u0) u0 = vertex[i].u;
+		if (vertex[i].u > u1) u1 = vertex[i].u;
+		if (vertex[i].v < v0) v0 = vertex[i].v;
+		if (vertex[i].v > v1) v1 = vertex[i].v;
+	}
+	for (int i = 0; i < n; i++) {
+		vertex[i].u = u1 > u0 ? (u_char)(((vertex[i].u - u0) * 255 + (u1 - u0) / 2) / (u1 - u0)) : 0;
+		vertex[i].v = v1 > v0 ? (u_char)(((vertex[i].v - v0) * 255 + (v1 - v0) / 2) / (v1 - v0)) : 0;
+		vertex[i].page = vertex[i].clut = 0;
+		vertex[i].tcx = vertex[i].tcy = 0;
+		vertex[i]._p0 = vertex[i]._p1 = 0;
+	}
+}
