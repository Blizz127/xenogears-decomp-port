+#include <stdlib.h> /* _xeno_hd2d_hooks */
+
+/* _xeno_hd2d_hooks: HOOK 1 (post-process) for the optional HD-2D lane
+ * (pc_port/src/hd2d).  Called at both present sites just before
+ * PsyX_RecordPresentedFrame(): the default framebuffer holds the finished
+ * frame, and the hook must leave GL state as it found it (and do nothing
+ * while its enhancement is off).  path: 0 = scene (PsyX_EndScene),
+ * 1 = VRAM display (PsyX_PresentDisplayFromVRAM). */
+extern "C" void PcPort_Hd2dPostProcess(int path, int drawable_w, int drawable_h) __attribute__((weak));
+
+/* _xeno_hd2d_hooks: XENO_PRESENT_HASH_LOG=file logs the CRC-32 of every
+ * presented frame (glReadPixels of the default framebuffer at the drawable
+ * size, RGBA8, after HOOK 1, before recording and the toolbar), one line per
+ * present: "<index> <S|V> <w>x<h> <crc32> <input-key> <frame>", frame being
+ * the XENO_PAD_TEST_INPUT schedule clock (-1 without a schedule).
+ * input-key is a CRC-32 of what the present was rendered FROM, so two runs
+ * whose wall-clock timing differs can still be compared frame for frame:
+ *   S: every draw batch flushed since the last present (vertex buffer,
+ *      split state and the VRAM-mirror texture pages and CLUTs it samples,
+ *      see PsyX_GPU.cpp DrawAllSplits), plus the display environment;
+ *   V: the VRAM mirror rows of the display area and the display state.
+ * XENO_PRESENT_HASH_LIMIT=N exits the process after N logged presents;
+ * XENO_PRESENT_HASH_UNTIL_FRAME=F exits at the first present at schedule
+ * frame >= F (that present is not logged).
+ * Used by pc_port/tests/run_hd2d_off_identity_test.sh; no cost when unset
+ * beyond one test per present and per draw flush. */
+static int g_xenoPresentHashInit = 0;
+static FILE* g_xenoPresentHashLog = NULL;
+static int g_xenoPresentHashCount = 0;
+static int g_xenoPresentHashLimit = 0;
+static unsigned char* g_xenoPresentHashPixels = NULL;
+static size_t g_xenoPresentHashBytes = 0;
+static unsigned int g_xenoCrcTable[256];
+static unsigned int g_xenoPresentInputKey = 0xFFFFFFFFu;
+static int g_xenoPresentHashUntilFrame = 0;
+extern "C" int PcPort_PadTestInputFrame(void) __attribute__((weak));
+
+extern "C" void PcPort_LogFlush(void) __attribute__((weak)); /* port stderr mirror (port_log.c) */
+static void PsyX_PresentHashExit(void)
+{
+	fclose(g_xenoPresentHashLog);
+	g_xenoPresentHashLog = NULL;
+	fprintf(stderr, "[present-hash] %d presents logged; exiting\n", g_xenoPresentHashCount);
+	fflush(stdout);
+	fflush(stderr);
+	if (PcPort_LogFlush) PcPort_LogFlush(); /* _Exit skips atexit: drain the mirror first */
+	_Exit(0);
+}
+
+static unsigned int PsyX_Crc32Update(unsigned int crc, const void* data, size_t bytes)
+{
+	const unsigned char* p = (const unsigned char*)data;
+	while (bytes--)
+		crc = g_xenoCrcTable[(crc ^ *p++) & 0xFF] ^ (crc >> 8);
+	return crc;
+}
+
+extern "C" int PsyX_PresentHashOn(void)
+{
+	if (!g_xenoPresentHashInit) {
+		const char* file = getenv("XENO_PRESENT_HASH_LOG");
+		const char* limit = getenv("XENO_PRESENT_HASH_LIMIT");
+		g_xenoPresentHashInit = 1;
+		if (!file || !*file)
+			return 0;
+		g_xenoPresentHashLog = fopen(file, "w");
+		if (!g_xenoPresentHashLog)
+			return 0;
+		g_xenoPresentHashLimit = limit ? atoi(limit) : 0;
+		g_xenoPresentHashUntilFrame = getenv("XENO_PRESENT_HASH_UNTIL_FRAME") ?
+			atoi(getenv("XENO_PRESENT_HASH_UNTIL_FRAME")) : 0;
+		for (unsigned int n = 0; n < 256; n++) {
+			unsigned int c = n;
+			for (int k = 0; k < 8; k++)
+				c = (c & 1) ? 0xEDB88320u ^ (c >> 1) : c >> 1;
+			g_xenoCrcTable[n] = c;
+		}
+	}
+	return g_xenoPresentHashLog != NULL;
+}
+
+/* Fold renderer input into the key of the next present (PsyX_GPU.cpp). */
+extern "C" void PsyX_PresentHashInput(const void* data, size_t bytes)
+{
+	g_xenoPresentInputKey = PsyX_Crc32Update(g_xenoPresentInputKey, data, bytes);
+}
+
+static void PsyX_PresentHashLog(int path)
+{
+	int w = 0, h = 0;
+	size_t bytes;
+	unsigned int crc, key;
+	int frame;
+	if (!PsyX_PresentHashOn())
+		return;
+	frame = PcPort_PadTestInputFrame ? PcPort_PadTestInputFrame() : -1;
+	if (g_xenoPresentHashUntilFrame > 0 && frame >= g_xenoPresentHashUntilFrame)
+		PsyX_PresentHashExit();
+	{
+		const int disp[8] = { currentDispEnv.disp.x, currentDispEnv.disp.y, currentDispEnv.disp.w,
+			currentDispEnv.disp.h, currentDispEnv.isrgb24, g_GPUDisabledState, path,
+			activeDispEnv.disp.x | (activeDispEnv.disp.y << 16) };
+		int y0 = currentDispEnv.disp.y, y1 = currentDispEnv.disp.y + currentDispEnv.disp.h;
+		if (y0 < 0) y0 = 0;
+		if (y1 > VRAM_HEIGHT) y1 = VRAM_HEIGHT;
+		key = path ? 0xFFFFFFFFu : g_xenoPresentInputKey;
+		if (path && y1 > y0)
+			key = PsyX_Crc32Update(key, &vram[y0 * VRAM_WIDTH], (size_t)(y1 - y0) * VRAM_WIDTH * sizeof(vram[0]));
+		key = PsyX_Crc32Update(key, disp, sizeof(disp)) ^ 0xFFFFFFFFu;
+		g_xenoPresentInputKey = 0xFFFFFFFFu;
+	}
+	SDL_GL_GetDrawableSize(g_window, &w, &h);
+	if (w <= 0 || h <= 0)
+		return;
+	bytes = (size_t)w * (size_t)h * 4;
+	if (bytes > g_xenoPresentHashBytes) {
+		free(g_xenoPresentHashPixels);
+		g_xenoPresentHashPixels = (unsigned char*)malloc(bytes);
+		g_xenoPresentHashBytes = g_xenoPresentHashPixels ? bytes : 0;
+		if (!g_xenoPresentHashPixels)
+			return;
+	}
+	glPixelStorei(GL_PACK_ALIGNMENT, 4);
+	glReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, g_xenoPresentHashPixels);
+	crc = PsyX_Crc32Update(0xFFFFFFFFu, g_xenoPresentHashPixels, bytes) ^ 0xFFFFFFFFu;
+	fprintf(g_xenoPresentHashLog, "%d %c %dx%d %08x %08x %d\n", g_xenoPresentHashCount,
+		path ? 'V' : 'S', w, h, crc, key, frame);
+	g_xenoPresentHashCount++;
+	if (g_xenoPresentHashLimit > 0 && g_xenoPresentHashCount >= g_xenoPresentHashLimit)
+		PsyX_PresentHashExit();
+}
