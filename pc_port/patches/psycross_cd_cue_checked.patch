+static int PsyX_CueLine(char* line, int* stage, char* imageName)
+{
+	char* cursor = line;
+	char* command = PsyX_CueToken(&cursor);
+	if (!cursor) return 0;
+	if (!command || !strcmp(command, "REM")) return 1;
+	char* first = PsyX_CueToken(&cursor);
+	if (!cursor || !first) return 0;
+	char* second = PsyX_CueToken(&cursor);
+	if (!cursor || !second) return 0;
+	char* extra = PsyX_CueToken(&cursor);
+	if (!cursor || extra) return 0;
+	if (*stage == 0 && !strcmp(command, "FILE"))
+	{
+		if (!*first || strlen(first) >= sizeof(g_cdImageBinaryFileName) ||
+			strcmp(second, "BINARY")) return 0;
+		strcpy(imageName, first);
+	}
+	else if (*stage == 1 && !strcmp(command, "TRACK"))
+	{
+		if ((strcmp(first, "01") && strcmp(first, "1")) ||
+			strcmp(second, "MODE2/2352")) return 0;
+	}
+	else if (*stage == 2 && !strcmp(command, "INDEX"))
+	{
+		if ((strcmp(first, "01") && strcmp(first, "1")) ||
+			strcmp(second, "00:00:00")) return 0;
+	}
+	else return 0;
+	++*stage;
+	return 1;
+}
 
