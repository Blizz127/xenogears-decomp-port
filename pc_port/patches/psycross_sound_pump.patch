+/* --- XENO_PC_PORT sound event pump (Phase 1) [_xeno_sound_pump] -------------------------------
+ * Retail SoundInitialize (0x80037C84) registers func_8003C020 as an RCntCNT2
+ * (root counter 2) interrupt event via OpenEvent, then
+ * SetRCnt(RCntCNT2, 0x44E8, EvMdINTR) + StartRCnt. RCnt2's default clock (mode
+ * 0x1000 carries no RCntMdSC/0x1 bit, so the port's own SetRCnt takes the
+ * `spec==2 && !(mode&1)` branch) is the system clock / 8 = 33.8688MHz/8 =
+ * 4.2336MHz; target 0x44E8 (17640) => 4233600/17640 = 240.0 Hz exactly.
+ * Nothing on the host retained the callback or advanced/dispatched the
+ * counter, so the tick never fired.  This registry plus PsyX_Sys_DispatchCounter2
+ * (driven at 240Hz by the interrupt thread, PsyX_main.cpp) is that missing
+ * infrastructure.  Lock-free by construction: each slot has one writer (the
+ * caller thread, at setup) and one reader (the interrupt thread); `in_use` is
+ * published last and marked volatile so the reader never sees a half-open slot.
+ * NOTE: cross-thread safety of the *callback body* against the main/field
+ * thread (retail relied on EnterCriticalSection disabling IRQs, a no-op here)
+ * is a later-phase concern -- the Phase-1 synthetic probe touches no shared
+ * state.  Only RCntCNT2/EvSpINT events are dispatched. */
+#define PSYX_EVENT_MAX 32
+typedef struct {
+	volatile int in_use;
+	volatile int enabled;
+	unsigned int desc;      /* event class, e.g. RCntCNT2 */
+	int          spec;      /* EvSpINT ... */
+	int          mode;      /* EvMdINTR ... */
+	long       (*func)();
+} PsyXEventSlot;
+static PsyXEventSlot s_psyxEvents[PSYX_EVENT_MAX];
+
+void PsyX_Sys_DispatchCounter2(void)
+{
+	int i;
+	for (i = 0; i < PSYX_EVENT_MAX; i++)
+	{
+		PsyXEventSlot* e = &s_psyxEvents[i];
+		if (e->in_use && e->enabled && e->func &&
+			e->desc == (unsigned int)RCntCNT2 && e->spec == EvSpINT)
+		{
+			e->func();
+		}
+	}
+}
+
 int SetRCnt(int spec, unsigned short target, int mode)//(F)
 {
 	int value = 0x48;
@@ -137,28 +179,51 @@ int StopRCnt(int spec)//TODO
 	return 0;
 }
 #undef OpenEvent
-int OpenEvent(unsigned int event, int unk01, int unk02, long(*func)())
+int OpenEvent(unsigned int event, int spec, int mode, long(*func)())
 {
-	PSYX_UNIMPLEMENTED();
+	int i;
+	for (i = 0; i < PSYX_EVENT_MAX; i++)
+	{
+		if (!s_psyxEvents[i].in_use)
+		{
+			s_psyxEvents[i].desc    = event;
+			s_psyxEvents[i].spec    = spec;
+			s_psyxEvents[i].mode    = mode;
+			s_psyxEvents[i].func    = func;
+			s_psyxEvents[i].enabled = 0;
+			/* publish last: the dispatch thread gates on in_use */
+			s_psyxEvents[i].in_use  = 1;
+			return i + 1;   /* handle; 0 stays reserved for "no free slot" */
+		}
+	}
 	return 0;
 }
 
 int CloseEvent(unsigned int event)
 {
-	PSYX_UNIMPLEMENTED();
-	return 0;
+	int idx = (int)event - 1;
+	if (idx >= 0 && idx < PSYX_EVENT_MAX)
+	{
+		s_psyxEvents[idx].in_use  = 0;
+		s_psyxEvents[idx].enabled = 0;
+	}
+	return 1;
 }
 
 int EnableEvent(unsigned int event)
 {
-	PSYX_UNIMPLEMENTED();
-	return 0;
+	int idx = (int)event - 1;
+	if (idx >= 0 && idx < PSYX_EVENT_MAX && s_psyxEvents[idx].in_use)
