+	glBindTexture(GL_TEXTURE_2D, decodedTexture);
+	glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+	free(pixels);
+	glBindTexture(GL_TEXTURE_2D, previousTexture);
+	glBindFramebuffer(GL_READ_FRAMEBUFFER, g_glBlitFramebuffer);
+	glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, decodedTexture, 0);
+	glBindFramebuffer(GL_DRAW_FRAMEBUFFER, 0);
+	const GLboolean scissorEnabled = glIsEnabled(GL_SCISSOR_TEST);
+	glDisable(GL_SCISSOR_TEST); /* VRAM copies do not use polygon scissors. */
+	glBlitFramebuffer(0, 0, w, h,
+	                  left, top, right, bottom,
+	                  GL_COLOR_BUFFER_BIT, GL_NEAREST);
+	if (scissorEnabled)
+		glEnable(GL_SCISSOR_TEST);
 	glBindFramebuffer(GL_FRAMEBUFFER, 0);
