+	/* _xeno_fb_materialize_rect: invert the draw-clip capture mapping;
+	 * a partial VRAM restore is not a full-screen background replacement. */
+	const RECT16& clip = activeDrawEnv.clip;
+	if (clip.w <= 0 || clip.h <= 0)
+		return;
+	const int left = (x - clip.x) * g_windowWidth / clip.w;
+	const int right = (x + w - clip.x) * g_windowWidth / clip.w;
+	const int top = g_windowHeight - (y - clip.y) * g_windowHeight / clip.h;
+	const int bottom = g_windowHeight - (y + h - clip.y) * g_windowHeight / clip.h;
+	u_int* pixels = (u_int*)malloc((size_t)w * h * sizeof(*pixels));
+	if (!pixels)
+		return;
+	for (int row = 0; row < h; ++row)
+		for (int col = 0; col < w; ++col)
+		{
+			unsigned short p = vram[((y + row) & (VRAM_HEIGHT - 1)) * VRAM_WIDTH +
+			                         ((x + col) & (VRAM_WIDTH - 1))];
+			u_int r = (p & 31) * 255 / 31;
+			u_int g = ((p >> 5) & 31) * 255 / 31;
+			u_int b = ((p >> 10) & 31) * 255 / 31;
+			pixels[row * w + col] = r | (g << 8) | (b << 16) | 0xff000000u;
+		}
+	GR_UpdateVRAM();
+	GLint previousTexture;
+	glGetIntegerv(GL_TEXTURE_BINDING_2D, &previousTexture);
+	if (!decodedTexture)
