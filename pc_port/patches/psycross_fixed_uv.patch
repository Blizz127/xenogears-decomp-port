new file mode 100644
index 0000000..ebffd8b
--- /dev/null
+++ b/src/render/PsyX_fixed_uv.h
@@ -0,0 +1,29 @@
+#pragma once
+
+#include <stdint.h>
+
+/* _xeno_fixed_uv: CPU-side transcription of the PCSX-Redux software GPU's
+ * textured-triangle edge/span interpolation.  Rows are uploaded as two
+ * RGBA32I texels: seed/step, then first-X/valid plus padding. */
+struct XenoFixedUvVertex
+{
+	int16_t x;
+	int16_t y;
+	uint8_t u;
+	uint8_t v;
+};
+
+struct XenoFixedUvRow
+{
+	int32_t seedU;
+	int32_t seedV;
+	int32_t stepU;
+	int32_t stepV;
+	int32_t firstX;
+	int32_t valid;
+	int32_t reserved0;
+	int32_t reserved1;
+};
+
+bool XenoBuildFixedUvRows(const XenoFixedUvVertex vertices[3], int width,
+	int height, XenoFixedUvRow* rows);
