+/* Match physical sample consumption to accelerated device clocks. This only
+ * changes OpenAL presentation pitch; the emulated VxPitch and ADSR stay intact.
+ * Follow the existing lock order: never call AL while holding s_StreamMutex. */
+void PsyX_SPUAL_RefreshHostSpeed()
+{
+	if (!SDL_AtomicGet(&g_spuInit)) return;
+	SDL_LockMutex(g_SpuMutex);
+	const float speed = (float)PsyX_GetSpeedMultiplier();
+	for (int i = 0; i < s_spuVoiceCount; i++) {
+		SPUALVoice* voice = &g_SpuVoices[i];
+		if (voice->alSource == AL_NONE) continue;
+		float pitch = s_streamMode ? 1.0f : voice->attr.pitch / 4096.0f;
+		if (pitch > 0) alSourcef(voice->alSource, AL_PITCH, pitch * speed);
+	}
+	if (s_xaAlReady) alSourcef(s_xaAlSource, AL_PITCH, speed);
+	SDL_UnlockMutex(g_SpuMutex);
+}
