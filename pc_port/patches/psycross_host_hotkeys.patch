+static void PsyX_InputTrace(const SDL_Event* event);
+extern "C" int PcPort_DevMenuEnabled(void);
+/* _xeno_host_hotkeys: F6 toggle + Backspace hold share one fast-forward. */
+static int g_xenoFastForwardToggle = 0;
+static int g_xenoFastForwardKeyHeld = 0;
+static int g_xenoFastForwardPadHeld = 0;
+static void PsyX_HostFastForwardUpdate()
+{
+	PsyX_SetFastForwardHeld(g_xenoFastForwardToggle || g_xenoFastForwardKeyHeld ||
+		g_xenoFastForwardPadHeld);
+}
+/* F6 / L3 (pad), dev menu Options; R3 hold (pad). */
+extern "C" int PsyX_HostFastForwardEnabled(void) { return g_xenoFastForwardToggle; }
+extern "C" void PsyX_HostFastForwardToggle(void)
+{
+	g_xenoFastForwardToggle ^= 1;
+	eprintinfo("Fast-forward: %s\n", g_xenoFastForwardToggle ? "on" : "off");
+	PsyX_HostFastForwardUpdate();
+}
+extern "C" void PsyX_HostFastForwardPadHold(int held)
+{
+	g_xenoFastForwardPadHeld = held ? 1 : 0;
+	PsyX_HostFastForwardUpdate();
+}
 
