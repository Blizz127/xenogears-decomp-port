+/* _xeno_sound_adsr: advance every live envelope by `cycles` 44100Hz steps
+ * (the 240Hz translator tick batches ~184, fractional-accumulated on the
+ * caller side) and apply the composed gain. A Release that reaches level 0
+ * stops the source -- the hardware voice simply falls silent; stopping the
+ * AL source retires its loop. */
+void PsyX_SPUAL_EnvelopeTick(int cycles)
+{
+	int i, c;
+
+	if (!g_spuInit)
+		return;
+
+	SDL_LockMutex(g_SpuMutex);
+	for (i = 0; i < s_spuVoiceCount; i++)
+	{
+		SPUALVoice* voice = &g_SpuVoices[i];
+
+		if (voice->alSource == AL_NONE || voice->env.phase == ADSR_OFF)
+			continue;
+
+		for (c = 0; c < cycles && voice->env.phase != ADSR_OFF; c++)
+			AdsrAdvanceCycle(&voice->env, voice->attr.adsr1, voice->attr.adsr2);
+
+		ApplyVoiceComposedGain(voice);
+
+		if (voice->env.phase == ADSR_OFF)
+			alSourceStop(voice->alSource);
+	}
+	SDL_UnlockMutex(g_SpuMutex);
+}
+
+/* _xeno_sound_adsr: live envelope readback (ENVX + Psy-Q key status). Backs
+ * LIBSPU's SpuGetVoiceEnvelope/SpuGetVoiceEnvelopeAttr -- the engine's seq
+ * cmd 0xFF frees a voice only once its envelope has fully decayed. */
+void PsyX_SPUAL_GetVoiceEnvelope(int vNum, long* keyStat, short* envx)
+{
+	int phase = ADSR_OFF;
+	int level = 0;
+
+	if (vNum >= 0 && vNum < s_spuVoiceCount)
+	{
+		phase = g_SpuVoices[vNum].env.phase;
+		level = g_SpuVoices[vNum].env.level;
+	}
+
+	if (envx)
+		*envx = (short)level;
+
+	if (keyStat)
+	{
+		if (phase == ADSR_OFF)
+			*keyStat = SPU_OFF;
+		else if (phase == ADSR_RELEASE)
+			*keyStat = (level != 0) ? SPU_OFF_ENV_ON : SPU_OFF;
+		else
+			*keyStat = (level != 0) ? SPU_ON : SPU_ON_ENV_OFF;
+	}
+}
+
+/* _xeno_sound_adsr: unit-test surface -- advance ONE 44100Hz cycle of the
+ * production envelope machine on caller-held state, so the golden-diff
+ * harness drives the exact code the runtime uses. */
+void PsyX_SPUAL_AdsrDebugCycle(u_short adsr1, u_short adsr2, int* phase, int* level, int* counter)
+{
+	SPUALAdsrState st;
+
+	st.phase = *phase;
+	st.level = *level;
+	st.counter = *counter;
+	AdsrAdvanceCycle(&st, adsr1, adsr2);
+	*phase = st.phase;
+	*level = st.level;
+	*counter = st.counter;
 }
