+/* _xeno_sound_adsr: THE composed-gain writer -- every AL_GAIN write for a
+ * voice goes through here (volume path and envelope tick both call it), so
+ * the two can never fight: AL_GAIN = baseGain * envelope/7FFFh, last-value
+ * suppressed. */
+static void ApplyVoiceComposedGain(SPUALVoice* voice)
+{
+	float g = voice->baseGain * (float)voice->env.level * (1.0f / 32767.0f);
+
+	if (g != voice->lastGain)
+	{
+		voice->lastGain = g;
+		alSourcef(voice->alSource, AL_GAIN, g);
+	}
+}
