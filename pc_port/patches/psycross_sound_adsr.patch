+/* _xeno_sound_adsr: advance one 44100Hz envelope cycle. Faithful to the
+ * psx-spx pseudocode: AdsrStep=(7-step)<<max(0,11-shift) (NOT'ed for
+ * decrease: -(8-step)<<sh, written that way because left-shifting a negative
+ * is UB in C), CounterIncrement=8000h>>max(0,shift-11), a step applies when
+ * the counter carries bit15 (then clears). Exponential increase is the
+ * documented fake (slower linear above 6000h); exponential decrease scales
+ * the step by level/8000h via >>15 (floor, not truncation -- keeps negative
+ * steps <= -1 so release/decay terminate; matches hardware-verified emulator
+ * cores). Rate all-bits-set never steps (7Fh attack/sustain, 1Fh release;
+ * decay's 4-bit shift can't reach it). Shifts above 26 follow the documented
+ * formula (psx-spx notes real hardware degrades oddly there; unused by
+ * games). Rates are read live from the ADSR words every cycle, as hardware
+ * does -- mid-note register changes apply. */
+static void AdsrAdvanceCycle(SPUALAdsrState* st, ushort adsr1, ushort adsr2)
+{
+	int shift, step2, exp, dec, target;
+	int adsr_step, counter_inc, never, sh_l;
+
+	switch (st->phase)
+	{
+	case ADSR_ATTACK:
+		shift = (adsr1 >> 10) & 0x1F;
+		step2 = (adsr1 >> 8) & 3;
+		exp = (adsr1 >> 15) & 1;
+		dec = 0;
+		target = 0x7FFF;
+		break;
+	case ADSR_DECAY:
+		shift = (adsr1 >> 4) & 0xF;
+		step2 = 0;
+		exp = 1;
+		dec = 1;
+		target = ((adsr1 & 0xF) + 1) * 0x800;
+		break;
+	case ADSR_SUSTAIN:
+		shift = (adsr2 >> 8) & 0x1F;
+		step2 = (adsr2 >> 6) & 3;
+		exp = (adsr2 >> 15) & 1;
+		dec = (adsr2 >> 14) & 1;
+		target = -1;	// sustain holds/ramps until KOFF
+		break;
+	case ADSR_RELEASE:
+		shift = adsr2 & 0x1F;
+		step2 = 0;
+		exp = (adsr2 >> 5) & 1;
+		dec = 1;
+		target = 0;
+		break;
+	default:
+		return;
+	}
+
+	sh_l = 11 - shift;
+	if (sh_l < 0)
+		sh_l = 0;
+	adsr_step = dec ? -((8 - step2) << sh_l) : ((7 - step2) << sh_l);
+	counter_inc = (shift > 11) ? (0x8000 >> (shift - 11)) : 0x8000;
+
+	if (exp && !dec && st->level > 0x6000)
+	{
+		if (shift < 10)
+			adsr_step >>= 2;
+		else if (shift >= 11)
+			counter_inc >>= 2;
+		else
+		{
+			adsr_step >>= 1;
+			counter_inc >>= 1;
+		}
+	}
+	else if (exp && dec)
+	{
+		adsr_step = (adsr_step * st->level) >> 15;
+	}
+
+	if (st->phase == ADSR_ATTACK || st->phase == ADSR_SUSTAIN)
+		never = (shift == 0x1F && step2 == 3);
+	else
+		never = (shift == 0x1F);
+	if (!never && counter_inc < 1)
+		counter_inc = 1;
+
+	st->counter += counter_inc;
+	if ((st->counter & 0x8000) == 0)
+		return;
+	st->counter = 0;
+
+	st->level += adsr_step;
+	if (!dec)
+	{
+		if (st->level > 0x7FFF)
+			st->level = 0x7FFF;
+	}
+	else
+	{
+		if (st->level < 0)
+			st->level = 0;
+	}
+
+	/* Phase transitions: counter cleared on entry; the level keeps its
+	 * stepped value (decay may land below (SL+1)*800h -- no re-clamp). */
+	if (st->phase == ADSR_ATTACK && st->level >= 0x7FFF)
+	{
+		st->level = 0x7FFF;
+		st->phase = ADSR_DECAY;
+		st->counter = 0;
+	}
+	else if (st->phase == ADSR_DECAY && st->level <= target)
+	{
+		st->phase = ADSR_SUSTAIN;
+		st->counter = 0;
+	}
+	else if (st->phase == ADSR_RELEASE && st->level <= 0)
+	{
+		st->level = 0;
+		st->phase = ADSR_OFF;
+	}
+}
