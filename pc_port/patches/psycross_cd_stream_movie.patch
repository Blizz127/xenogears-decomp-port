+static int XaFloorShift15(int value)
+{
+	return value >= 0 ? value / 32768 : -((-value + 32767) / 32768);
+}
+
+static short XaZigZagInterpolate(const short* ring, unsigned int table,
+	                              unsigned int pos)
+{
+	int sum = 0;
+	unsigned int i;
+	for (i = 0; i < 29; i++)
+		sum += XaFloorShift15((int)ring[(pos - i) & 31] *
+		                      (int)s_xaZigZag[table][i]);
+	return XaSaturate(sum);
+}
+
+static void XaResetResampler(void)
+{
+	memset(s_xaResampleRing, 0, sizeof(s_xaResampleRing));
+	s_xaResamplePos = 0;
+	s_xaResampleSixstep = 6;
+}
+
+static int XaResample37800(const short* src, int frames, short* dst)
+{
+	int inFrame;
+	int outFrame = 0;
+	for (inFrame = 0; inFrame < frames; inFrame++)
+	{
+		unsigned int phase;
+		s_xaResampleRing[0][s_xaResamplePos] = src[inFrame * 2];
+		s_xaResampleRing[1][s_xaResamplePos] = src[inFrame * 2 + 1];
+		s_xaResamplePos = (s_xaResamplePos + 1) & 31;
+		s_xaResampleSixstep--;
+		if (s_xaResampleSixstep != 0)
+			continue;
+		s_xaResampleSixstep = 6;
+		for (phase = 0; phase < 7; phase++)
+		{
+			dst[outFrame * 2] = XaZigZagInterpolate(
+				s_xaResampleRing[0], phase, s_xaResamplePos);
+			dst[outFrame * 2 + 1] = XaZigZagInterpolate(
+				s_xaResampleRing[1], phase, s_xaResamplePos);
+			outFrame++;
+		}
+	}
+	return outFrame;
+}
