 volatile int g_cdSpoolerSeekCmd = 0;
 
+/* _xeno_cd_stream_movie: real-time pacing of the spooler.  A real drive
+ * delivers one sector every 1/75 s (1/150 s at CdlModeSpeed); the STR
+ * player's 32-slot ring depends on that cadence.  The spooler is only used
+ * for CdlReadS streaming (CdRead/CdReadSync are synchronous), so it always
+ * sleeps to the drive rate. */
+static Uint64 g_xeno_cdPaceNext = 0;
+
+static void _eCdSpoolerPace(void)
+{
+	Uint64 freq;
+	Uint64 period;
+	Uint64 now;
+
+	freq = SDL_GetPerformanceFrequency();
+	period = freq / ((g_xeno_cdMode & CdlModeSpeed) ? 150 : 75);
+	now = SDL_GetPerformanceCounter();
+
+	if (g_xeno_cdPaceNext == 0 || now > g_xeno_cdPaceNext + period * 8)
+		g_xeno_cdPaceNext = now;
+
+	while (SDL_GetPerformanceCounter() < g_xeno_cdPaceNext)
+	{
+		Uint64 remain = g_xeno_cdPaceNext - SDL_GetPerformanceCounter();
+		if (remain * 1000 > freq * 2)
+			SDL_Delay(1);
+	}
+	g_xeno_cdPaceNext += period;
+}
