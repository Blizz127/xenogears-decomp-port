+/* _xeno_cd_xa: decode one Mode-2/Form-2 XA audio payload.  The retail
+ * Xenogears movie corpus uses coding 01h: stereo, 4-bit ADPCM, 37800 Hz.
+ * Each 128-byte group contains four 28-frame blocks; the low and high nibble
+ * of each data byte are the left and right channels respectively.  Filter
+ * history is continuous across sectors, as on the PSX CD-to-SPU path. */
+static int XaDecodeSector(const u_char* src, int size, u_char coding, short* dst)
+{
+	int channels = (coding & 1) + 1;
+	int rate = (coding & 4) ? 18900 : 37800;
+	int group, block, sample;
+	int left1 = s_xaHistoryLeft1;
+	int left2 = s_xaHistoryLeft2;
+	int right1 = s_xaHistoryRight1;
+	int right2 = s_xaHistoryRight2;
+	int out = 0;
+
+	if (!src || size < 2304 || channels != 2 || rate != 37800 ||
+		(coding & 0x30) != 0)
+	{
+		if (!s_xaUnsupported)
+		{
+			eprintwarn("PSX XA: unsupported coding %02x (need stereo 4-bit/37800)\n", coding);
+			s_xaUnsupported = 1;
+		}
+		return 0;
+	}
+
+	for (group = 0; group < 18; group++)
+	{
+		const u_char* in = src + group * 128;
+		for (block = 0; block < 4; block++)
+		{
+			int lp = in[4 + block * 2];
+			int rp = in[5 + block * 2];
+			int lparam = lp & 0x0F;
+			int rparam = rp & 0x0F;
+			int lshift;
+			int rshift;
+			int lf = (lp >> 4) & 0x0F;
+			int rf = (rp >> 4) & 0x0F;
+
+			/* XA supports filters 0..3.  The CD decoder treats reserved shift
+			 * parameters 13..15 as 9 rather than performing an invalid shift. */
+			if (lf > 3 || rf > 3)
+			{
+				if (!s_xaUnsupported)
+				{
+					eprintwarn("PSX XA: invalid ADPCM header in coding %02x\n", coding);
+					s_xaUnsupported = 1;
+				}
+				return 0;
+			}
+			if (lparam > 12) lparam = 9;
+			if (rparam > 12) rparam = 9;
+			lshift = 12 - lparam;
+			rshift = 12 - rparam;
+
+			for (sample = 0; sample < 28; sample++)
+			{
+				int packed = in[16 + block + sample * 4];
+				int ln = packed & 0x0F;
+				int rn = (packed >> 4) & 0x0F;
+				int ls, rs;
+
+				if (ln & 8) ln -= 16;
+				if (rn & 8) rn -= 16;
+				ls = (ln << lshift) + ((left1 * s_adpcmF0[lf] +
+					left2 * s_adpcmF1[lf] + 32) >> 6);
+				rs = (rn << rshift) + ((right1 * s_adpcmF0[rf] +
+					right2 * s_adpcmF1[rf] + 32) >> 6);
+				if (ls > 32767) ls = 32767;
+				else if (ls < -32768) ls = -32768;
+				if (rs > 32767) rs = 32767;
+				else if (rs < -32768) rs = -32768;
+				dst[out++] = (short)ls;
+				dst[out++] = (short)rs;
+				left2 = left1;
+				left1 = ls;
+				right2 = right1;
+				right1 = rs;
+			}
+		}
+	}
+
+	s_xaHistoryLeft1 = (short)left1;
+	s_xaHistoryLeft2 = (short)left2;
+	s_xaHistoryRight1 = (short)right1;
+	s_xaHistoryRight2 = (short)right2;
+	return out / 2;
+}
