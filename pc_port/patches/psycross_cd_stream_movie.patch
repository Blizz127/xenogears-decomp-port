+#ifndef __EMSCRIPTEN__
+/* The callback only moves already-decoded frames.  It never calls OpenAL or
+ * blocks on any lock other than the transport mutex. */
+static ALsizei AL_APIENTRY XaStreamCallback(ALvoid* userptr, ALvoid* sampledata,
+	                                           ALsizei numbytes)
+{
+	short* dst = (short*)sampledata;
+	unsigned int frames = (unsigned int)(numbytes / (ALsizei)(sizeof(short) * 2));
+	unsigned int i;
+	(void)userptr;
+
+	SDL_LockMutex(s_StreamMutex);
+	for (i = 0; i < frames; i++)
+	{
+		if (!s_xaActive || s_xaFrames == 0)
+		{
+			dst[i * 2] = 0;
+			dst[i * 2 + 1] = 0;
+			continue;
+		}
+		XaMixFrame(s_xaMixEnabled, s_xaVolumeLeft, s_xaVolumeRight,
+		           s_xaAttenuation0, s_xaAttenuation1,
+		           s_xaAttenuation2, s_xaAttenuation3,
+		           s_xaRing[s_xaReadFrame * 2],
+		           s_xaRing[s_xaReadFrame * 2 + 1],
+		           &dst[i * 2], &dst[i * 2 + 1]);
+		s_xaReadFrame = (s_xaReadFrame + 1) % XA_RING_FRAMES;
+		s_xaFrames--;
+	}
+	SDL_UnlockMutex(s_StreamMutex);
+	return (ALsizei)(frames * sizeof(short) * 2);
+}
+#endif
+
+static void XaResetLocked(void)
+{
+	s_xaReadFrame = 0;
+	s_xaWriteFrame = 0;
+	s_xaFrames = 0;
+	s_xaHistoryLeft1 = s_xaHistoryLeft2 = 0;
+	s_xaHistoryRight1 = s_xaHistoryRight2 = 0;
+	XaResetResampler();
+}
+
+void PsyX_SPUAL_CdSetMode(int mode)
+{
+	if (!s_StreamMutex)
+		return;
+	SDL_LockMutex(s_StreamMutex);
+	XaResetLocked();
+	s_xaActive = (mode & 0x40) != 0; /* CdlModeRT: CD-XA ADPCM enabled */
+	s_xaUnsupported = 0;
+	s_xaOverruns = 0;
+	SDL_UnlockMutex(s_StreamMutex);
+}
+
+void PsyX_SPUAL_CdPushXaSector(const unsigned char* payload, int size, unsigned char coding)
+{
+	short decoded[XA_FRAMES_PER_SECTOR * 2];
+	short resampled[XA_OUTPUT_FRAMES_PER_SECTOR * 2];
+	int frames;
+	int i;
+
+	if (!s_StreamMutex)
+		return;
+	SDL_LockMutex(s_StreamMutex);
+	if (!s_xaActive)
+	{
+		SDL_UnlockMutex(s_StreamMutex);
+		return;
+	}
+	frames = XaDecodeSector(payload, size, coding, decoded);
+	if (frames <= 0)
+	{
+		SDL_UnlockMutex(s_StreamMutex);
+		return;
+	}
+	frames = XaResample37800(decoded, frames, resampled);
+	if ((unsigned int)frames > XA_RING_FRAMES - s_xaFrames)
+	{
+		s_xaOverruns++;
+		if (s_xaOverruns == 1)
+			eprintwarn("PSX XA: output ring overrun; dropping sector\n");
+		SDL_UnlockMutex(s_StreamMutex);
+		return;
+	}
+	for (i = 0; i < frames; i++)
+	{
+		s_xaRing[s_xaWriteFrame * 2] = resampled[i * 2];
+		s_xaRing[s_xaWriteFrame * 2 + 1] = resampled[i * 2 + 1];
+		s_xaWriteFrame = (s_xaWriteFrame + 1) % XA_RING_FRAMES;
+	}
+	s_xaFrames += frames;
+	SDL_UnlockMutex(s_StreamMutex);
+}
+
+void PsyX_SPUAL_SetCdVolume(short left, short right)
+{
+	if (!s_StreamMutex)
+		return;
+	SDL_LockMutex(s_StreamMutex);
+	s_xaVolumeLeft = left;
+	s_xaVolumeRight = right;
+	SDL_UnlockMutex(s_StreamMutex);
+}
+
+void PsyX_SPUAL_SetCdAttenuation(unsigned char val0, unsigned char val1,
+	                              unsigned char val2, unsigned char val3)
+{
+	if (!s_StreamMutex)
+	{
+		s_xaAttenuation0 = val0;
+		s_xaAttenuation1 = val1;
+		s_xaAttenuation2 = val2;
+		s_xaAttenuation3 = val3;
+		return;
+	}
+	SDL_LockMutex(s_StreamMutex);
+	s_xaAttenuation0 = val0;
+	s_xaAttenuation1 = val1;
+	s_xaAttenuation2 = val2;
+	s_xaAttenuation3 = val3;
+	SDL_UnlockMutex(s_StreamMutex);
+}
+
+void PsyX_SPUAL_SetCdMix(int enabled)
+{
+	if (!s_StreamMutex)
+	{
+		s_xaMixEnabled = enabled != 0;
+		return;
+	}
+	SDL_LockMutex(s_StreamMutex);
+	s_xaMixEnabled = enabled != 0;
+	SDL_UnlockMutex(s_StreamMutex);
+}
