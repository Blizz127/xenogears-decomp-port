+static void XaApplyCdAttenuation(unsigned char val0, unsigned char val1,
+	                             unsigned char val2, unsigned char val3,
+	                             short inputLeft, short inputRight,
+	                             short* outputLeft, short* outputRight)
+{
+	int left = (((int)inputLeft * val0) >> 7) +
+	           (((int)inputRight * val2) >> 7);
+	int right = (((int)inputLeft * val1) >> 7) +
+	            (((int)inputRight * val3) >> 7);
+	*outputLeft = XaSaturate(left);
+	*outputRight = XaSaturate(right);
+}
+
+static void XaMixFrame(int enabled, short volumeLeft, short volumeRight,
+	                   unsigned char val0, unsigned char val1,
+	                   unsigned char val2, unsigned char val3,
+	                   short inputLeft, short inputRight,
+	                   short* outputLeft, short* outputRight)
+{
+	int left = 0;
+	int right = 0;
+
+	if (enabled)
+	{
+		short attenuatedLeft;
+		short attenuatedRight;
+		XaApplyCdAttenuation(val0, val1, val2, val3,
+		                     inputLeft, inputRight,
+		                     &attenuatedLeft, &attenuatedRight);
+		left = ((int)attenuatedLeft * volumeLeft + 0x4000) >> 15;
+		right = ((int)attenuatedRight * volumeRight + 0x4000) >> 15;
+	}
+	*outputLeft = XaSaturate(left);
+	*outputRight = XaSaturate(right);
+}
