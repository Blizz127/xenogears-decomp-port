+/* _xeno_vram_copy_extent: how many rows of `w` shorts, starting at vram[off]
+ * and stepping VRAM_WIDTH per row, stay inside vram[]. Zero if a single row
+ * does not fit (which also covers a negative offset or extent). */
+static int GR_XenoVRAMRowsInBounds(int off, int w)
+{
+	const int words = VRAM_WIDTH * VRAM_HEIGHT;
+
+	if (off < 0 || w <= 0 || off > words - w)
+		return 0;
+
+	return (words - off - w) / VRAM_WIDTH + 1;
+}
