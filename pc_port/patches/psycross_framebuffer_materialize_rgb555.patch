--- a/src/render/PsyX_render.cpp
+++ b/src/render/PsyX_render.cpp
@@ -1999,13 +1999,40 @@
 void GR_MaterializeFramebufferRect(int x, int y, int w, int h)
 {
 #if USE_OPENGL
-	GR_UpdateVRAM();
-	glBindFramebuffer(GL_READ_FRAMEBUFFER, g_glBlitFramebuffer);
-	glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, g_vramTexture, 0);
-	glBindFramebuffer(GL_DRAW_FRAMEBUFFER, 0);
-	glBlitFramebuffer(x, y, x + w, y + h,
+	/* _xeno_fb_materialize_rgb555: g_vramTexture's RG channels contain
+	 * the low/high bytes of PS1 words, not displayable RGB. Decode the
+	 * CPU mirror written by MoveImage before restoring the backbuffer. */
+	static GLuint decodedTexture = 0;
+	if (w <= 0 || h <= 0 || w > VRAM_WIDTH || h > VRAM_HEIGHT)
+		return;
+	u_int* pixels = (u_int*)malloc((size_t)w * h * sizeof(*pixels));
+	if (!pixels)
+		return;
+	for (int row = 0; row < h; ++row)
+		for (int col = 0; col < w; ++col)
+		{
+			unsigned short p = vram[((y + row) & (VRAM_HEIGHT - 1)) * VRAM_WIDTH +
+			                         ((x + col) & (VRAM_WIDTH - 1))];
+			u_int r = (p & 31) * 255 / 31;
+			u_int g = ((p >> 5) & 31) * 255 / 31;
+			u_int b = ((p >> 10) & 31) * 255 / 31;
+			pixels[row * w + col] = r | (g << 8) | (b << 16) | 0xff000000u;
+		}
+	GR_UpdateVRAM();
+	GLint previousTexture;
+	glGetIntegerv(GL_TEXTURE_BINDING_2D, &previousTexture);
+	if (!decodedTexture)
+		glGenTextures(1, &decodedTexture);
+	glBindTexture(GL_TEXTURE_2D, decodedTexture);
+	glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, w, h, 0, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+	free(pixels);
+	glBindTexture(GL_TEXTURE_2D, previousTexture);
+	glBindFramebuffer(GL_READ_FRAMEBUFFER, g_glBlitFramebuffer);
+	glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, decodedTexture, 0);
+	glBindFramebuffer(GL_DRAW_FRAMEBUFFER, 0);
+	glBlitFramebuffer(0, 0, w, h,
 	                  0, g_windowHeight, g_windowWidth, 0,
 	                  GL_COLOR_BUFFER_BIT, GL_NEAREST);
 	glBindFramebuffer(GL_FRAMEBUFFER, 0);
 #endif
 }
