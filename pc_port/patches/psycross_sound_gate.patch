+ * DisableEvent bracket on the tick event; the pump's TryLock drops ticks
+ * while held. Depth rides s_soundTickHold so nesting with Disable/Enable
+ * brackets on the same thread stays balanced. */
+void PsyX_Sys_SoundGateEnterCritical(void)
+{
+	if (!g_SoundTickMutex)   /* single-threaded early boot */
+		return;
+	SDL_LockMutex(g_SoundTickMutex);
+	s_soundTickHold++;
+}
+
+void PsyX_Sys_SoundGateExitCritical(void)
+{
+	if (!g_SoundTickMutex)
+		return;
+	if (s_soundTickHold > 0)
+	{
+		s_soundTickHold--;
+		SDL_UnlockMutex(g_SoundTickMutex);
+	}
 }
 
