+/* Integer-exact SPU ADPCM block decode: 16 bytes -> 28 samples.
+ * Returns the block's flag byte; p1/p2 are the persistent filter history. */
+static int AdpcmDecodeBlock(const u_char* blk, short* out, short* p1, short* p2)
+{
+	int shift = blk[0] & 0x0F;
+	int filt = (blk[0] >> 4) & 0x07;
+	int i, n;
+	int h1 = *p1, h2 = *p2;
+
+	if (shift > 12)
+		shift = 9;
+	if (filt > 4)
+		filt = 4;
+
+	for (i = 0; i < 14; i++)
+	{
+		int b = blk[2 + i];
+		for (n = 0; n < 2; n++)
+		{
+			int nib = (n == 0) ? (b & 0x0F) : ((b >> 4) & 0x0F);
+			int s;
+			if (nib > 7)
+				nib -= 16;
+			s = (nib << 12) >> shift;
+			s += (h1 * s_adpcmF0[filt] + h2 * s_adpcmF1[filt] + 32) >> 6;
+			if (s > 32767) s = 32767;
+			else if (s < -32768) s = -32768;
+			out[i * 2 + n] = (short)s;
+			h2 = h1;
+			h1 = s;
+		}
+	}
+	*p1 = (short)h1;
+	*p2 = (short)h2;
+	return blk[1];
+}
+
+/* 4-tap Gaussian: hist[0]=oldest .. hist[3]=newest, idx = counter bits
+ * 4-11.  Per psx-spx each product is SAR 15 individually, then summed. */
+static int GaussInterp(const short* hist, int idx)
+{
+	int out;
+	out  = (s_gaussTable[0x0FF - idx] * hist[0]) >> 15;
+	out += (s_gaussTable[0x1FF - idx] * hist[1]) >> 15;
+	out += (s_gaussTable[0x100 + idx] * hist[2]) >> 15;
+	out += (s_gaussTable[0x000 + idx] * hist[3]) >> 15;
+	return out;
+}
+
+/* Advance one source sample through the block/loop machinery. Caller holds
+ * s_StreamMutex. */
+static void StreamConsumeSample(SPUALVoice* voice)
+{
+	SPUALStream* st = &voice->stream;
+
+	if (!st->blockValid || st->sampleIdx == 28)
+	{
+		if (st->blockValid)
+		{
+			/* The finished block's flags choose the next address (hardware
+			 * processes LoopEnd AFTER playing the block). */
+			if (st->flags & ADPCM_FLAG_LOOP_END)
+			{
+				st->curAddr = st->repeatAddr;
+				if (!(st->flags & ADPCM_FLAG_REPEAT))
+					SDL_AtomicSet(&st->endMutePending, 1);
+			}
+			else
+			{
+				st->curAddr += 16;
+			}
+		}
+		if (st->curAddr + 16 > SPU_MEMSIZE)
+			st->curAddr = 0;
+		/* LoopStart latches at decode time ("copies current address"). */
+		if (s_SpuMemory.samplemem[st->curAddr + 1] & ADPCM_FLAG_LOOP_START)
+			st->repeatAddr = st->curAddr;
+		st->flags = AdpcmDecodeBlock(s_SpuMemory.samplemem + st->curAddr,
+		                             st->block, &st->p1, &st->p2);
+		st->sampleIdx = 0;
+		st->blockValid = 1;
+	}
+
+	st->hist[0] = st->hist[1];
+	st->hist[1] = st->hist[2];
+	st->hist[2] = st->hist[3];
+	st->hist[3] = st->block[st->sampleIdx++];
+}
+
+/* The AL_SOFT_callback_buffer fill, invoked on OpenAL's mixer thread.
+ * Takes ONLY s_StreamMutex; never calls into OpenAL. */
+#ifndef __EMSCRIPTEN__
+static ALsizei AL_APIENTRY StreamCallback(ALvoid* userptr, ALvoid* sampledata, ALsizei numbytes)
+{
+	int vi = (int)(intptr_t)userptr;
+	SPUALVoice* voice = &g_SpuVoices[vi];
+	short* dst = (short*)sampledata;
+	int n = numbytes / 2;
+	int i;
+
+	SDL_LockMutex(s_StreamMutex);
+	{
+		SPUALStream* st = &voice->stream;
+
+		if (st->pendingRestart)
+		{
+			/* Addresses were staged by SetKey on the tick side (under this
+			 * mutex); the callback never reads voice->attr except pitch. */
+			st->pendingRestart = 0;
+			st->active = 1;
+			st->p1 = st->p2 = 0;
+			st->hist[0] = st->hist[1] = st->hist[2] = st->hist[3] = 0;
+			st->counter = 0;
+			st->sampleIdx = 0;
+			st->blockValid = 0;
+		}
+
+		if (!st->active)
+		{
+			for (i = 0; i < n; i++)
+				dst[i] = 0;
+		}
+		else
+		{
+			unsigned int step = voice->attr.pitch;
+			if (step > 0x3FFF)
+				step = 0x4000;
+			for (i = 0; i < n; i++)
+			{
+				int gi;
+				st->counter += step;
+				while (st->counter >= 0x1000)
+				{
+					st->counter -= 0x1000;
+					StreamConsumeSample(voice);
+				}
+				gi = (st->counter >> 4) & 0xFF;
+				dst[i] = (short)GaussInterp(st->hist, gi);
+			}
+		}
+	}
+	SDL_UnlockMutex(s_StreamMutex);
+	return numbytes;
+}
+#endif
