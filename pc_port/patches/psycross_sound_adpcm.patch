+/* _xeno_sound_adpcm: unit-test surfaces driving the production code. */
+void PsyX_SPUAL_AdpcmDecodeDebug(const unsigned char* data, int nBlocks,
+                                 short* outPcm, short* p1io, short* p2io)
+{
+	int b;
+	for (b = 0; b < nBlocks; b++)
+		AdpcmDecodeBlock(data + b * 16, outPcm + b * 28, p1io, p2io);
+}
+
+int PsyX_SPUAL_GaussDebug(const short* hist4, int idx)
+{
+	return GaussInterp(hist4, idx & 0xFF);
+}
