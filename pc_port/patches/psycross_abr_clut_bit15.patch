+/* A paletted semi-transparent primitive with ABR 1/2/3 needs two consecutive
+ * passes: CLUT bit15-clear texels overwrite, while bit15-set texels blend.
+ * The fragment shader discards the opposite set in each pass, so the passes
+ * are disjoint for this primitive and retain PSX packet ordering. */
+static bool BeginTexturedSplit(bool semiTrans)
+{
+	const TexFormat texFormat = GET_TPAGE_FORMAT(activeDrawEnv.tpage);
+	const int abr = (activeDrawEnv.tpage >> 5) & 3;
+	const bool splitClutSemi = semiTrans && overrideTexture == 0 && abr != 0 &&
+		(texFormat == TF_4_BIT || texFormat == TF_8_BIT);
+
+	AddSplit(splitClutSemi ? false : semiTrans, true,
+		splitClutSemi ? CLUT_SEMI_CLEAR_ONLY : CLUT_SEMI_ALL);
+	return splitClutSemi;
+}
+
+static void EndTexturedSplit(bool splitClutSemi, int vertexCount)
+{
+	const int sourceIndex = g_vertexIndex;
+	g_vertexIndex += vertexCount;
+	if (!splitClutSemi)
+		return;
+
+	AddSplit(true, true, CLUT_SEMI_SET_ONLY);
+	memcpy(&g_vertexBuffer[g_vertexIndex], &g_vertexBuffer[sourceIndex], vertexCount * sizeof(GrVertex));
+	g_vertexIndex += vertexCount;
+}
