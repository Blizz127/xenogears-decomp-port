+
+/* The caller must already own a reservation on this thread. */
+extern "C" int PsyX_Sys_ValidateSoundEventReservation(unsigned int event, int enabled)
+{
+    if (!s_soundReservation || event != s_soundReservation ||
+        event < 1 || event > PSYX_EVENT_MAX)
+        return 0;
+    PsyXEventSlot* slot = &s_psyxEvents[event - 1];
+    return slot->in_use && PsyX_EventSlotIsSoundTick(slot) &&
+           s_eventGeneration[event - 1] == s_soundReservationGeneration &&
+           !!slot->enabled == !!enabled;
