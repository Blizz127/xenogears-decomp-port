diff --git a/src/pad/PsyX_pad.cpp b/src/pad/PsyX_pad.cpp
--- a/src/pad/PsyX_pad.cpp
+++ b/src/pad/PsyX_pad.cpp
@@ -23,6 +23,11 @@ int						g_cfg_controllerToSlotMapping[MAX_CONTROLLERS] = { -1, -1 };
 
 PsyXController			g_controllers[MAX_CONTROLLERS];
 const u_char*			g_sdlKeyboardState = NULL;
+/* _xeno_keyboard_tap_latch: active-low buttons observed as SDL KEYDOWN
+ * events since the last pad update.  SDL_GetKeyboardState only exposes the
+ * final held state, so a complete tap drained by an earlier event poll would
+ * otherwise vanish. */
+u_short				g_latchedKeyboardInputs = 0xFFFF;
 
 u_short PsyX_Pad_UpdateKeyboardInput();
 void	PsyX_Pad_UpdateGameControllerInput(SDL_GameController* cont, LPPADRAW pad);
@@ -419,9 +424,36 @@ u_short PsyX_Pad_UpdateKeyboardInput()
 	if (g_sdlKeyboardState[mapping.kc_start])//START
 		ret &= ~0x8;
 
+	ret &= g_latchedKeyboardInputs;
+	g_latchedKeyboardInputs = 0xFFFF;
 	return ret;
 }
 
+void PsyX_Pad_LatchKeyboardInput(int scancode)
+{
+	u_short ret = 0xFFFF;
+	const PsyXKeyboardMapping& mapping = g_cfg_keyboardMapping;
+
+	if (scancode == mapping.kc_square) ret &= ~0x8000;
+	if (scancode == mapping.kc_circle) ret &= ~0x2000;
+	if (scancode == mapping.kc_triangle) ret &= ~0x1000;
+	if (scancode == mapping.kc_cross) ret &= ~0x4000;
+	if (scancode == mapping.kc_l1) ret &= ~0x400;
+	if (scancode == mapping.kc_l2) ret &= ~0x100;
+	if (scancode == mapping.kc_l3) ret &= ~0x2;
+	if (scancode == mapping.kc_r1) ret &= ~0x800;
+	if (scancode == mapping.kc_r2) ret &= ~0x200;
+	if (scancode == mapping.kc_r3) ret &= ~0x4;
+	if (scancode == mapping.kc_dpad_up) ret &= ~0x10;
+	if (scancode == mapping.kc_dpad_down) ret &= ~0x40;
+	if (scancode == mapping.kc_dpad_left) ret &= ~0x80;
+	if (scancode == mapping.kc_dpad_right) ret &= ~0x20;
+	if (scancode == mapping.kc_select) ret &= ~0x1;
+	if (scancode == mapping.kc_start) ret &= ~0x8;
+
+	g_latchedKeyboardInputs &= ret;
+}
