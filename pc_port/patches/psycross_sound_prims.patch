+/* _xeno_sound_prims: drive the OpenAL EFX reverb params from the PSX reverb
+ * mode/depth (LIBSPU SpuSetReverbModeType/Depth). Behavioral wiring for the
+ * sound init-proof milestone, gated on the awake backend + EFX support. */
+void PsyX_SPUAL_ApplyReverbParams(float gain, float decayTime, float gainHF)
+{
+	if (!g_spuInit)
+		return;
+#ifndef __EMSCRIPTEN__
+	if (!g_ALEffectsSupported)
+		return;
+	if (gain < 0.0f) gain = 0.0f; else if (gain > 1.0f) gain = 1.0f;
+	if (gainHF < 0.0f) gainHF = 0.0f; else if (gainHF > 1.0f) gainHF = 1.0f;
+	if (decayTime < 0.1f) decayTime = 0.1f; else if (decayTime > 20.0f) decayTime = 20.0f;
+	alEffectf(g_nAlReverbEffect, AL_REVERB_GAIN, gain);
+	alEffectf(g_nAlReverbEffect, AL_REVERB_GAINHF, gainHF);
+	alEffectf(g_nAlReverbEffect, AL_REVERB_DECAY_TIME, decayTime);
+	/* re-commit the modified effect into the active aux slot */
+	alAuxiliaryEffectSloti(g_ALEffectSlots[g_currEffectSlotIdx], AL_EFFECTSLOT_EFFECT, g_nAlReverbEffect);
+#else
+	(void)gain; (void)decayTime; (void)gainHF;
+#endif
+}
+
+/* _xeno_sound_prims: PSX master output volume (SpuSetCommonAttr mvol) mapped
+ * to the OpenAL listener gain. Stored even before the backend is awake so a
+ * later SpuInit/apply picks it up; read back by the primitive probe. */
+static float g_psxMasterGain = 1.0f;
+void PsyX_SPUAL_SetMasterVolume(float gain)
+{
+	if (gain < 0.0f) gain = 0.0f; else if (gain > 1.0f) gain = 1.0f;
+	g_psxMasterGain = gain;
+	if (!g_spuInit)
+		return;
+	alListenerf(AL_GAIN, gain);
+}
+
+float PsyX_SPUAL_GetMasterVolume()
+{
+	return g_psxMasterGain;
+}
