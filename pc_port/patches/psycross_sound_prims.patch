+/* PSX reverb mode -> OpenAL EFX preset (gain, decayTime[s], gainHF). Depth from
+ * SpuSetReverbModeDepth scales the gain; mode 0 (OFF) collapses reverb. */
+typedef struct { float gain; float decay; float gainHF; } PsyXReverbPreset;
+static const PsyXReverbPreset s_reverbPresets[SPU_REV_MODE_MAX] = {
+	/* OFF      */ { 0.00f, 0.10f, 0.00f },
+	/* ROOM     */ { 0.30f, 0.80f, 0.30f },
+	/* STUDIO_A */ { 0.35f, 1.00f, 0.30f },
+	/* STUDIO_B */ { 0.40f, 1.30f, 0.30f },
+	/* STUDIO_C */ { 0.45f, 1.60f, 0.30f },
+	/* HALL     */ { 0.55f, 2.80f, 0.25f },
+	/* SPACE    */ { 0.60f, 4.00f, 0.20f },
+	/* ECHO     */ { 0.50f, 3.00f, 0.40f },
+	/* DELAY    */ { 0.50f, 3.00f, 0.40f },
+	/* PIPE     */ { 0.50f, 2.00f, 0.35f },
+};
+
+static void PsyX_ApplyReverbState(void)
+{
+	int mode = s_reverbAttr.mode & 0xFF;   /* strip SPU_REV_MODE_CLEAR_WA etc. */
+	PsyXReverbPreset p;
+	short dl = s_reverbAttr.depth.left;
+	short dr = s_reverbAttr.depth.right;
+	float depth;
+
+	if (mode < 0 || mode >= SPU_REV_MODE_MAX)
+		mode = 0;
+	p = s_reverbPresets[mode];
+
+	/* PSX depth is 0..0x7FFF per channel; use the louder channel as scalar */
+	depth = (float)((dl > dr) ? dl : dr) / 32767.0f;
+	if (depth < 0.0f) depth = 0.0f; else if (depth > 1.0f) depth = 1.0f;
+
+	PsyX_SPUAL_ApplyReverbParams(p.gain * depth, p.decay, p.gainHF);
+}
